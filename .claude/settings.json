{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(scripts/ci-web-stub.sh)",
      "Bash(scripts/gen-bindings.sh)",
      "Bash(scripts/cargo-audit.sh)",
      "Bash(sh scripts/test-install.sh)",
      "Bash(scripts/issue.sh *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit * --add-label in-progress)",
      "Bash(gh issue edit * --remove-label in-progress)",
      "Bash(gh issue edit * --remove-label in-progress --add-label blocked)",
      "Bash(gh issue edit * --add-label question)",
      "Bash(gh issue edit * --remove-label ready --add-label question)",
      "Bash(gh issue edit * --remove-label question)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *refs/heads/main)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue edit *--add-label ready*)",
      "Bash(gh issue edit *--add-label later*)",
      "Bash(gh issue create *--label ready*)",
      "Bash(gh issue create *--label later*)",
      "Bash(cargo publish *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Read(~/.claude/projects/**/*.jsonl)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "svelte@svelte": true,
    "rust-review@trailofbits": true,
    "differential-review@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools",
        "ref": "f9d22f2f7f7cd5e4596eef5d108a69ac8f0dd48d"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills",
        "ref": "149d7b21f4067765b82e67029730b42d228ef4b4"
      }
    }
  }
}
