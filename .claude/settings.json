{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(scripts/ci-web-stub.sh)",
      "Bash(scripts/gen-bindings.sh)",
      "Bash(scripts/cargo-audit.sh)",
      "Bash(sh scripts/test-install.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(cargo publish *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Read(~/.claude/projects/**/*.jsonl)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "svelte@svelte": true,
    "rust-review@trailofbits": true,
    "differential-review@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools",
        "ref": "f9d22f2f7f7cd5e4596eef5d108a69ac8f0dd48d"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills",
        "ref": "149d7b21f4067765b82e67029730b42d228ef4b4"
      }
    }
  }
}
